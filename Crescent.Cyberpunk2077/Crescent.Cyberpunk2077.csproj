<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Crescent.Cyberpunk2077</RootNamespace>
        <CrescentInstallDir>E:\Silk\Personal\Pictures\Crescent Mod Manager</CrescentInstallDir>
        <OutputPath>$(CrescentInstallDir)\Managed\Crescent.Cyberpunk2077\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Markup.Declarative" Version="12.1.2-fix-agent.1"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2"/>
        <PackageReference Include="SharpCompress" Version="0.50.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Crescent.ModManager\Crescent.ModManager.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

</Project>