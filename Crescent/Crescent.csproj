<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>crescent.ico</ApplicationIcon>
        <PublisherName>Silk15</PublisherName>
        <ProductName>Crescent Mod Manager</ProductName>
        <CrescentInstallDir>E:\Silk\Personal\Pictures\Crescent Mod Manager</CrescentInstallDir>
        <PublishSingleFile>false</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <Company>Silk15</Company>
        <Product>Crescent Mod Manager</Product>
        <AssemblyTitle>Crescent Mod Manager</AssemblyTitle>
        <Description>A free mod manager capable of supporting any game</Description>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <OutputPath>$(CrescentInstallDir)\Managed\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <RootNamespace>Crescent</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Crescent.Utilities\Crescent.Utilities.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="crescent.ico" />
    </ItemGroup>
</Project>